{
    "Steam-WebKit": "./css/webkit.css",
    "Patches": [
        {
            "MatchRegexString": "^Steam$",
            "TargetCss": "./css/steam.css",
            "TargetJs": "./js/steam.js"
        },
        {
            "MatchRegexString": ".friendsui-container",
            "TargetCss": "./css/friends.custom.css"
        },
        {
            "MatchRegexString": "Menu$",
            "TargetCss": "./css/menus.css"
        },
        {
            "MatchRegexString": "Supernav$",
            "TargetCss": "./css/supernavs.css"
        },
        {
            "MatchRegexString": ".ModalDialogPopup",
            "TargetCss": "./libraryroot.custom.css"
        },
        {
            "MatchRegexString": ".FullModalOverlay",
            "TargetCss": "./libraryroot.custom.css"
        },
        {
            "MatchRegexString": "^notificationtoasts_",
            "TargetCss": "./css/toasts.css"
        },
        {
            "MatchRegexString": "^SteamBrowser_Find$",
            "TargetCss": "./libraryroot.custom.css"
        },
        {
            "MatchRegexString": "^OverlayTab\\d+_Find$",
            "TargetCss": "./libraryroot.custom.css"
        },
        {
            "MatchRegexString": "^OverlayBrowser_Browser$",
            "TargetCss": "./libraryroot.custom.css"
        },
        {
            "MatchRegexString": "^SP Overlay:",
            "TargetCss": "./libraryroot.custom.css"
        }
    ],
    "UseDefaultPatches": false,
    "Conditions": {
        "Effects": {
            "description": "Off / Subtle / Full. Subtle adds a light CRT texture plus text-decode on hover; Full adds heavier scanlines, a fast refresh band, the occasional signal jolt and drawing menu borders. Pick Subtle if you are unsure.",
            "tab": "Effects",
            "default": "Subtle",
            "values": {
                "Off": {
                    "TargetCss": {
                        "affects": ["^Steam$"],
                        "src": "./css/effects-off.css"
                    }
                },
                "Subtle": {
                    "TargetCss": {
                        "affects": ["^Steam$"],
                        "src": "./css/effects-subtle.css"
                    }
                },
                "Full": {
                    "TargetCss": {
                        "affects": ["^Steam$"],
                        "src": "./css/effects-full.css"
                    }
                }
            }
        },
        "Sound (hum / hover / click)": {
            "description": "Synthesised CRT hum and UI clicks, generated with WebAudio - no audio files involved. Starts after your first click. Turn off if you want silence.",
            "tab": "Effects",
            "default": "yes",
            "values": {
                "yes": {
                    "TargetJs": {
                        "affects": ["^Steam$"],
                        "src": "./js/sound.js"
                    }
                },
                "no": {
                    "TargetJs": {
                        "affects": ["^Steam$"],
                        "src": "./js/sound-off.js"
                    }
                }
            }
        }
    },
    "author": "SUmmerLunch",
    "description": "A Serial Experiments Lain themed Steam client skin. Based on blueArchiveSteamSkin.",
    "name": "Lain",
    "version": "1.10.3",
    "github": {
        "owner": "SUmmerLunchhh",
        "repo_name": "Lain_Steam_Theme"
    },
    "tags": [
        "Dark",
        "Cyberpunk",
        "Anime",
        "Lain"
    ],
    "header_image": "https://raw.githubusercontent.com/SUmmerLunchhh/Lain_Steam_Theme/main/header_image.jpeg",
    "splash_image": "https://raw.githubusercontent.com/SUmmerLunchhh/AAA-/main/imgs/mmexport1788630950993.jpg"
}
